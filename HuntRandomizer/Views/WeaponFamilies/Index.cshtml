@model ListWeaponFamiliesViewModel

<div class="container" id="InnerContainer">
    <div class="row">
        <div class="col-12">
            <h1>Weapon Families</h1>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <p>
                This page shows an overview of all weapon families currently registered in the application. Weapon families are used to add and store individual weapons, which can then be used to generate loadouts. 
                If you're seeing this page without loggin in, something went wrong!
            </p>
        </div>
    </div>
    @if (!Model.WeaponFamilies.Any())
    {
        <div class="row">
            <div class="col-12">
                <p class="alert">
                    There are currently no Weapon Families stored in the database.
                </p>
                <p>
                    <a asp-action="Create" asp-controller="WeaponFamilies" class="btn btn-primary">Add one</a>
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Name</th>
                                <th scope="col">Description</th>
                                <th scope="col">Action</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var family in Model.WeaponFamilies)
                            {
                                <tr>
                                    <td>@family.Id</td>
                                    <td>@family.Name</td>
                                    <td>@family.Description</td>
                                    <td colspan="2">
                                        <a class="btn btn-outline-primary" asp-action="Details" asp-controller="WeaponFamilies" asp-route-weaponFamilyId="@family.Id">Details</a>
                                        <a class="btn btn-outline-info" asp-action="ListByFamily" asp-controller="Weapons" asp-route-weaponFamilyId="@family.Id">See weapons</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="justify-content-center">
                                    <a asp-action="Create" asp-controller="WeaponFamilies" class="btn btn-primary">Add new</a>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>